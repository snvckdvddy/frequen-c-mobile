# Frequen-C Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# All EXPO_PUBLIC_ vars are inlined at build time by Expo.

# ─── Spotify (free) ──────────────────────────────────────────
# Create app at: https://developer.spotify.com/dashboard
# Set redirect URI to: frequenc://
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# ─── Last.fm (free) ──────────────────────────────────────────
# Create account at: https://www.last.fm/api/account/create
EXPO_PUBLIC_LASTFM_API_KEY=

# ─── Tidal (developer account required) ─────────────────────
# Register redirect URI to your current runtime callback.
# Native/dev-build baseline usually starts with: frequenc://
EXPO_PUBLIC_TIDAL_CLIENT_ID=

# ─── SoundCloud (developer app required) ────────────────────
# Public client ID used to start the browser auth flow.
EXPO_PUBLIC_SOUNDCLOUD_CLIENT_ID=

# ─── Google Sign In ────────────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Web Client ID is used by Android; iOS Client ID is the native bundle-specific one.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ─── Backend / Socket ────────────────────────────────────────
# Option A: Explicit hosted endpoints (tunnel, cloud env, etc.)
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SOCKET_URL=

# Option B: Local LAN fallback if overrides above are empty
# For physical device testing, set this to the current LAN IP of the machine
# running Frequen-C-Backend. Do not leave an old IP here after network changes.
EXPO_PUBLIC_LOCAL_IP=
EXPO_PUBLIC_API_PORT=5000

# ─── Development mode ────────────────────────────────────────
# true  -> run with local mocks, backend not required
# false -> call real backend/socket
EXPO_PUBLIC_USE_MOCKS=false

# ─── Auth bypass (testing only) ─────────────────────────────
# true  -> skip Login/Register and auto-authenticate a local test user
# Note: this also forces USE_MOCKS=true so mobile UI can be tested without backend auth
EXPO_PUBLIC_BYPASS_AUTH=false
