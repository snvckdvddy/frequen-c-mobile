{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "141946415324-u45pd9d3bub5huli0ja92bh6lpv4da7b.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "141946415324-0v0u7fns6640s4pthqbhandg5p6l5qm5.apps.googleusercontent.com"
      }
    },
    "preview:apk": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "141946415324-u45pd9d3bub5huli0ja92bh6lpv4da7b.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "141946415324-0v0u7fns6640s4pthqbhandg5p6l5qm5.apps.googleusercontent.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "141946415324-u45pd9d3bub5huli0ja92bh6lpv4da7b.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "141946415324-0v0u7fns6640s4pthqbhandg5p6l5qm5.apps.googleusercontent.com"
      }
    }
  }
}
