{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE_WITH_RAILWAY_DOMAIN",
        "EXPO_PUBLIC_SOCKET_URL": "wss://REPLACE_WITH_RAILWAY_DOMAIN"
      }
    },
    "preview:apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE_WITH_RAILWAY_DOMAIN",
        "EXPO_PUBLIC_SOCKET_URL": "wss://REPLACE_WITH_RAILWAY_DOMAIN"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE_WITH_RAILWAY_DOMAIN",
        "EXPO_PUBLIC_SOCKET_URL": "wss://REPLACE_WITH_RAILWAY_DOMAIN"
      }
    }
  }
}
