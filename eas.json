{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app"
      }
    },
    "preview:apk": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_BYPASS_AUTH": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://frequen-c-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://frequen-c-backend-production.up.railway.app"
      }
    }
  }
}
